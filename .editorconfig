root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java follows the Spring code style (tabs).
[*.java]
indent_style = tab
indent_size = 4

[pom.xml]
indent_style = tab
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
