# Local development values. Copy to .env (never commit .env) and change them if you like.
# Production values are set in the hosting platform, never in a file.

# Base domain for band subdomains: {slug}.BASE_DOMAIN. Locally *.localhost resolves to 127.0.0.1.
BASE_DOMAIN=localhost
# Web (SPA + /api proxy): http://app.localhost:3000
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=bandcore
# Superuser of the local container, used only by the bootstrap script.
POSTGRES_SUPERUSER_PASSWORD=dev_only_superuser_password
# bandcore_owner owns the schema and runs Flyway migrations.
DB_OWNER_PASSWORD=dev_only_owner_password
# bandcore_app is the runtime role used by the API.
DB_APP_PASSWORD=dev_only_app_password
# Published on 127.0.0.1 for local tools (psql, IDE).
DB_PORT=5432

# Authentication (used from M2). At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Email (used from M2). Locally every email goes to Mailpit: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=bandcore <no-reply@localhost>
MAILPIT_UI_PORT=8025
