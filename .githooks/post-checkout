#!/bin/sh
# Warns (does not block) when the checked-out branch name does not follow the standard.
# $3 = 1 for a branch checkout, 0 for a file checkout.
[ "$3" = "1" ] || exit 0
branch=$(git symbolic-ref --short -q HEAD) || exit 0
sh "$(dirname "$0")/lib/validate-branch.sh" "$branch" 2>&1 | sed 's/^ERROR/WARNING/' >&2
exit 0
