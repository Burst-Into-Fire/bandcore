#!/bin/sh
# Validates the branch name and every commit that is not on the remote yet.
# stdin: <local ref> <local sha> <remote ref> <remote sha>
lib="$(dirname "$0")/lib"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch

  branch=${local_ref#refs/heads/}
  sh "$lib/validate-branch.sh" "$branch" || status=1

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  tmp=$(mktemp)
  # shellcheck disable=SC2086
  for sha in $(git rev-list --no-merges $range); do
    git log -1 --format=%B "$sha" > "$tmp"
    if ! sh "$lib/validate-message.sh" "$tmp"; then
      printf '  in commit %s. Reword it with: git rebase -i %s^\n' "$(git log -1 --format='%h %s' "$sha")" "$sha" >&2
      status=1
    fi
  done
  rm -f "$tmp"
done

exit $status
